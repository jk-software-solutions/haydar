[Unit]
Description=HADIR Next.js service
After=network-online.target hadir-api.service
Wants=network-online.target

[Service]
Type=simple
User=hadir
Group=hadir
WorkingDirectory=/opt/hadir/current/apps/web
EnvironmentFile=/etc/hadir/web.env
ExecStart=/usr/bin/pnpm start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/hadir
UMask=0027

[Install]
WantedBy=multi-user.target
