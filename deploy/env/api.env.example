APP_ENV=production
APP_NAME=HADIR
DATABASE_URL=postgresql+asyncpg://hadir_app:CHANGE_ME@127.0.0.1:5432/hadir
MIGRATION_DATABASE_URL=postgresql+asyncpg://hadir_migrator:CHANGE_ME@127.0.0.1:5432/hadir
JWT_SECRET=<GENERATE_AT_LEAST_32_RANDOM_BYTES>
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=https://hadir.example.com
PLATFORM_ADMIN_EMAILS=owner@example.com
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
DEFAULT_TIMEZONE=Asia/Riyadh
LOG_LEVEL=INFO
